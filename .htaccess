RewriteEngine On

# Alle anderen Hostnamen (www., pflege-nachbarin.de, deine-pflegehilfe.de, ...) -> https://pflegehilfe-mg.de (301)
RewriteCond %{HTTP_HOST} !^pflegehilfe-mg\.de$ [NC]
RewriteRule ^ https://pflegehilfe-mg.de%{REQUEST_URI} [L,R=301]

# http -> https
RewriteCond %{HTTPS} off
RewriteRule ^ https://pflegehilfe-mg.de%{REQUEST_URI} [L,R=301]
